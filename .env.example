# ── DATABASE ──────────────────────────────────────────────────────────
# Railway provides this automatically when you add PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── SERVER ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
BASE_URL=https://your-app.railway.app   # your Railway deployment URL

# ── GOOGLE OAUTH ──────────────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-app.railway.app/auth/google/callback

# ── CLAUDE AI ─────────────────────────────────────────────────────────
# Get from: console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxx

# ── EMAIL (RESEND) ────────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=AI Review Reply <digest@yourdomain.com>

# ── PAYMENTS (LEMON SQUEEZY) ──────────────────────────────────────────
# Get from: app.lemonsqueezy.com → Settings → Webhooks
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_secret
